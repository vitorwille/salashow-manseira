        +string Location
        +string Capacity
        +bool Busy
        +List~string~ Extras
        +RoomModel()
        +RoomModel(roomCode, roomName, roomLocation, roomCapacity, roomBusy, roomExtras)
    }

    class RequestorModel {
        -string _id
        -string _name
        -string _department
        -string _phone
